{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.1.0",
  "identifier": "com.vox.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vox 设置",
        "width": 960,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "float",
        "title": "Vox",
        "url": "float.html",
        "width": 460,
        "height": 92,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "app",
    "category": "Productivity",
    "shortDescription": "无登录的语音输入工具",
    "longDescription": "听写 / 翻译 / Ask Anything，使用你自己的 MiniMax 接口"
  }
}